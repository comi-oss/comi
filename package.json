{
  "name": "comi",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "cd src && ../node_modules/.bin/tauri",
    "android:build": "bash scripts/android.sh build --apk --split-per-abi --target aarch64 x86_64",
    "android:dev": "bash scripts/android.sh dev",
    "android:init": "bash scripts/android.sh init --ci --skip-targets-install",
    "android:sign-preview": "bash scripts/sign-preview.sh",
    "waydroid:display": "bash scripts/waydroid-display.sh",
    "waydroid:recording": "bash scripts/copy-waydroid-recording.sh",
    "catalog:publish": "bash scripts/publish-catalog.sh",
    "worker:deploy": "cd src/cloudflare-worker && pnpm dlx wrangler deploy"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
