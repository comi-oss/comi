{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CF Map",
  "version": "0.1.0",
  "identifier": "id.mikira.cf.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "CF Map",
      "width": 432,
      "height": 960,
      "backgroundColor": "#fbf7ea"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cf.mikira.id; object-src 'none'; base-uri 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "The Comifuro map, in your pocket.",
    "android": { "minSdkVersion": 24 }
  }
}
